{
  "name": "vlad/reviews-tutor-lms",
  "description": "enables the course reviews for Tutor LMS installation and allows you to manage them.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "yoast/phpunit-polyfills": "^2.0",
    "phpstan/phpstan": "*",
    "szepeviktor/phpstan-wordpress": "*",
    "phpstan/extension-installer": "*",
    "wp-coding-standards/wpcs": "^3.1",
    "phpcompatibility/phpcompatibility-wp": "^2.1"
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml.dist",
    "test:coverage": "phpunit --configuration phpunit.xml.dist --coverage-html ./coverage",
    "lint": "phpcs",
    "lint:fix": "phpcbf",
    "analyse": "phpstan analyse",
    "install-wp-tests": "bash bin/install-wp-tests.sh wordpress_test root root localhost latest"
  },
  "autoload-dev": {
    "classmap": [
      "tests/test-main.php",
      "tests/test-reviews.php"
    ]
  },
  "config": {
    "platform": {
      "php": "7.4.33"
    },
    "allow-plugins": {
      "phpstan/extension-installer": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
